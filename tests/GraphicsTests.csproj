<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><EnableDefaultCompileItems>false</EnableDefaultCompileItems><OutputPath>bin/Graphics/</OutputPath><IntermediateOutputPath>obj/Graphics/</IntermediateOutputPath></PropertyGroup>
  <ItemGroup>
    <Compile Include="GraphicsTests.cs" />
    <Compile Include="../LocalMod/EmoteChat/CSharp/Client/PickerPaint.cs" />
    <Compile Include="../LocalMod/EmoteChat/CSharp/Shared/Format.cs" />
    <Compile Include="../LocalMod/EmoteChat/CSharp/Shared/AnimationPlayback.cs" />
    <Reference Include="MonoGame.Framework.Windows.NetStandard"><HintPath>$(RuntimeDir)/MonoGame.Framework.Windows.NetStandard.dll</HintPath></Reference>
    <Reference Include="XNATypes"><HintPath>$(RuntimeDir)/XNATypes.dll</HintPath></Reference>
    <Reference Include="SharpDX"><HintPath>$(RuntimeDir)/SharpDX.dll</HintPath></Reference>
    <Reference Include="SharpDX.Direct3D11"><HintPath>$(RuntimeDir)/SharpDX.Direct3D11.dll</HintPath></Reference>
    <Reference Include="SharpDX.DXGI"><HintPath>$(RuntimeDir)/SharpDX.DXGI.dll</HintPath></Reference>
    <Reference Include="SharpDX.Direct2D1"><HintPath>$(RuntimeDir)/SharpDX.Direct2D1.dll</HintPath></Reference>
    <!-- Do not copy the game's self-contained CLR/host DLLs into this framework-dependent test. -->
    <None Include="$(RuntimeDir)/SharpDX*.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
